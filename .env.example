# Copy to .env, fill in your key, then start Uvicorn with --env-file .env.
# Existing shell environment variables take precedence over .env values.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: gemini -> ollama -> existing evidence/ML fallback.
# Leave empty until Ollama is running and a model has been pulled.
LLM_FALLBACK_PROVIDERS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Used only when openai is selected (or LLM_PROVIDER is unset).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional legacy Copilot-only override: DEVELOPER_COPILOT_MODEL

# Optional read-only DAG source directory; defaults to ../airflow/dags.
# AIRFLOW_DAG_SOURCE_ROOT=D:/Projects/airflow/dags
